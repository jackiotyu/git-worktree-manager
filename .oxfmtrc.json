{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "printWidth": 120,
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "quoteProps": "as-needed",
    "jsxSingleQuote": false,
    "trailingComma": "all",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "always",
    "proseWrap": "preserve",
    "htmlWhitespaceSensitivity": "css",
    "endOfLine": "lf",
    "embeddedLanguageFormatting": "auto",
    "ignorePatterns": [
        ".github",
        ".vscode",
        "*.md",
        "pnpm-lock.yaml",
        "package.json",
        "schemas/*",
        "out",
        "dist",
        "node_modules",
        "**/*.d.ts",
        "webpack.config.js",
        "src/@types/vscode.git.enums.ts",
        "rspack.config.js",
        "rstest.config.js"
    ]
}
