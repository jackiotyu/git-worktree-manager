{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "%schema.workspace.title%",
  "description": "%schema.workspace.description%",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "repo"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "%schema.workspace.version%"
    },
    "parent": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "%schema.workspace.parent%"
    },
    "repo": {
      "type": "object",
      "minProperties": 1,
      "description": "%schema.workspace.repo%",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*[:*?\"<>|])(?!.*(?:^|[/\\\\])\\.{1,2}(?:[/\\\\]|$)).+$",
        "description": "%schema.workspace.repoPath%"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "%schema.workspace.name%",
            "pattern": "\\S"
          },
          "remote": {
            "type": "string",
            "minLength": 1,
            "description": "%schema.workspace.remote%",
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
